@base = http://localhost:5010

# @name login
POST {{base}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "admin-pass" }

### Search with the token from the login above
GET {{base}}/api/companies?name=bil
Authorization: Bearer {{login.response.body.$.accessToken}}



@reader = {{$dotenv READER_TOKEN}}
@importer = {{$dotenv IMPORTER_TOKEN}}

### Search companies (reader)
GET {{base}}/api/companies?name=bil&orgForm=AS
Authorization: Bearer {{reader}}

### One company (reader)
GET {{base}}/api/companies/912855414
Authorization: Bearer {{reader}}

### No token: expect 401
GET {{base}}/api/companies

### Reader tries to import: expect 403
POST {{base}}/api/imports
Authorization: Bearer {{reader}}

### Start an import (importer): expect 202
POST {{base}}/api/imports
Authorization: Bearer {{importer}}

### Import history (importer)
GET {{base}}/api/imports
Authorization: Bearer {{importer}}
